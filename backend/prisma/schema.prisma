// Prisma Schema for 语境记忆背单词软件
// 数据库：MySQL 8.0
// 版本：v1.3
// 日期：2025年10月28日
// 更新：添加用户学习目标设置，重构打卡系统

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// 用户相关表
// ============================================

/// 用户表 - 存储用户基本信息
model User {
  id                Int       @id @default(autoincrement())
  username          String    @unique @db.VarChar(255)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  currentBookTagId  Int?      @map("current_book_tag_id")
  dailyLearningGoal Int       @default(10) @map("daily_learning_goal") // 每日学习目标（单词数）
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamp(0)

  // 关联关系
  currentBookTag    BookTag?             @relation("UserCurrentBook", fields: [currentBookTagId], references: [id])
  learningProgress  UserLearningProgress[]
  wordNotebook      UserWordNotebook[]
  dailyCheckIns     DailyCheckIn[]
  achievements      UserAchievement[]

  @@map("users")
}

// ============================================
// 单词数据表
// ============================================

/// 单词基础表 - 存储单词原文和音标
model Word {
  id             Int      @id @default(autoincrement())
  word           String   @unique @db.VarChar(255)
  pronunciation  String   @db.Text // JSON格式: {"uk": "/ˈwɜːrd/", "us": "/ˈwɝːd/"}

  // 关联关系
  partsOfSpeech  PartOfSpeech[]
  bookTags       WordTagRelation[]
  wordNotebook   UserWordNotebook[]

  @@index([word])
  @@map("words")
}

/// 词性表 - 一个单词可以有多个词性
model PartOfSpeech {
  id            Int       @id @default(autoincrement())
  wordId        Int       @map("word_id")
  partOfSpeech  String    @map("part_of_speech") @db.VarChar(50)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)

  // 关联关系
  word          Word      @relation(fields: [wordId], references: [id], onDelete: Cascade)
  meanings      Meaning[]

  @@index([wordId])
  @@index([partOfSpeech])
  @@map("parts_of_speech")
}

/// 词义表 - 存储详细释义
model Meaning {
  id              Int       @id @default(autoincrement())
  partOfSpeechId  Int       @map("part_of_speech_id")
  definition      String    @db.Text
  relatedInfo     String?   @map("related_info") @db.Text // JSON格式，存储词典例句、同反义词等
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)

  // 关联关系
  partOfSpeech    PartOfSpeech              @relation(fields: [partOfSpeechId], references: [id], onDelete: Cascade)
  examples        MeaningExampleRelation[]
  learningProgress UserLearningProgress[]

  @@index([partOfSpeechId])
  @@map("meanings")
}

// ============================================
// 例句相关表
// ============================================

/// 例句中央池 - 存储所有例句，支持复用
model ExamplePool {
  id          Int       @id @default(autoincrement())
  sentence    String    @db.Text
  source      String    @db.VarChar(50) // '真题' 或 'AI生成'
  difficulty  String    @db.VarChar(50) // 如：小学、四级、考研
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)

  // 关联关系
  meanings    MeaningExampleRelation[]

  @@index([source])
  @@index([difficulty])
  @@map("example_pool")
}

/// 词义-例句关联表 - 建立多对多关系
model MeaningExampleRelation {
  meaningId      Int    @map("meaning_id")
  exampleId      Int    @map("example_id")
  highlightWord  String @map("highlight_word") @db.VarChar(255)
  orderInMeaning Int?   @map("order_in_meaning")

  // 关联关系
  meaning        Meaning      @relation(fields: [meaningId], references: [id], onDelete: Cascade)
  example        ExamplePool  @relation(fields: [exampleId], references: [id], onDelete: Cascade)

  @@id([meaningId, exampleId])
  @@index([meaningId])
  @@index([exampleId])
  @@map("meaning_example_relation")
}

// ============================================
// 词书相关表
// ============================================

/// 词书标签表 - 存储词书名称
model BookTag {
  id            Int       @id @default(autoincrement())
  tagName       String    @unique @map("tag_name") @db.VarChar(255)
  isUserDefined Boolean   @default(false) @map("is_user_defined")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(0)

  // 关联关系
  words         WordTagRelation[]
  users         User[]            @relation("UserCurrentBook")

  @@index([tagName])
  @@map("book_tags")
}

/// 单词-标签关联表 - 建立多对多关系
model WordTagRelation {
  wordId       Int    @map("word_id")
  bookTagId    Int    @map("book_tag_id")
  masteryFocus String @map("mastery_focus") @db.VarChar(50) // 'recognition' 或 'production'

  // 关联关系
  word         Word    @relation(fields: [wordId], references: [id], onDelete: Cascade)
  bookTag      BookTag @relation(fields: [bookTagId], references: [id], onDelete: Cascade)

  @@id([wordId, bookTagId])
  @@index([wordId])
  @@index([bookTagId])
  @@map("word_tag_relations")
}

// ============================================
// 用户学习相关表
// ============================================

/// 用户学习进度表 - 记录对每个词义的学习进度（艾宾浩斯曲线核心表）
model UserLearningProgress {
  id                 Int       @id @default(autoincrement())
  userId             Int       @map("user_id")
  meaningId          Int       @map("meaning_id")
  masteryLevel       Int       @default(0) @map("mastery_level") // 0-5
  lastReviewAt       DateTime? @map("last_review_at") @db.Timestamp(0)
  nextReviewAt       DateTime  @map("next_review_at") @db.Timestamp(0)
  reviewCount        Int       @default(0) @map("review_count")
  consecutiveCorrect Int       @default(0) @map("consecutive_correct")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)

  // 关联关系
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  meaning            Meaning   @relation(fields: [meaningId], references: [id], onDelete: Cascade)

  @@unique([userId, meaningId])
  @@index([userId])
  @@index([meaningId])
  @@index([nextReviewAt])
  @@map("user_learning_progress")
}

/// 用户生词本表
model UserWordNotebook {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  wordId   Int      @map("word_id")
  addedAt  DateTime @default(now()) @map("added_at") @db.Timestamp(0)

  // 关联关系
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  word     Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId])
  @@index([wordId])
  @@map("user_word_notebook")
}

/// 每日打卡表
model DailyCheckIn {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  checkInDate     DateTime @map("check_in_date") @db.Date
  
  // 学习统计（单词级别，对用户友好）
  wordsLearned    Int      @default(0) @map("words_learned")    // 今日学习的单词数（去重）
  wordsReviewed   Int      @default(0) @map("words_reviewed")   // 今日复习的单词数（去重）
  
  // 内部统计（词义级别，精确跟踪）
  meaningsLearned Int      @default(0) @map("meanings_learned") // 今日学习的词义数
  meaningsReviewed Int     @default(0) @map("meanings_reviewed")// 今日复习的词义数
  
  // 目标管理
  dailyGoal       Int      @default(10) @map("daily_goal")      // 当日学习目标（快照）
  goalCompleted   Boolean  @default(false) @map("goal_completed")// 是否完成目标
  
  // 连续打卡
  consecutiveDays Int      @default(0) @map("consecutive_days")  // 连续打卡天数

  // 关联关系
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, checkInDate])
  @@index([userId])
  @@index([checkInDate])
  @@map("daily_check_ins")
}

/// 用户成就表
model UserAchievement {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  achievementName String   @map("achievement_name") @db.VarChar(255)
  awardedAt       DateTime @default(now()) @map("awarded_at") @db.Timestamp(0)

  // 关联关系
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementName])
  @@index([userId])
  @@map("user_achievements")
}

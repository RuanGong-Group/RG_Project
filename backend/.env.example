# 服务器配置
PORT=3000
NODE_ENV=development

# 数据库配置
# 重要：请将 "password" 替换为您本地 MySQL root 用户的真实密码
DATABASE_URL="mysql://root:password@localhost:3306/vocabulary_db"

# JWT 配置
# 生产环境必须更改为强密码
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Redis 配置（可选，不配置则自动使用内存存储）
# REDIS_URL=redis://localhost:6379

# AI 服务配置（视频生成功能需要）
# SiliconFlow API 密钥（用于 DeepSeek 文本生成）
SILICONFLOW_API_KEY=your-siliconflow-api-key-here

# 豆包图像生成 API 配置（火山引擎，必需）
# 重要：视频生成功能强制依赖豆包 API，缺少此配置将无法生成视频
DOUBAO_API_KEY=your-doubao-api-key-here
# DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3  # 可选，使用默认值
# DOUBAO_IMAGE_MODEL=doubao-seedream-4-0-250828  # 可选，使用默认值
# DOUBAO_IMAGE_STYLE=comic  # 可选，comic | realistic

# --- 新增：腾讯云 COS 配置 (视频上传用) ---
# 登录腾讯云控制台 -> 访问管理 -> API密钥管理 获取
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
# 登录腾讯云控制台 -> 对象存储 -> 存储桶列表 获取
COS_BUCKET_NAME=your-bucket-name-125xxxxxxx
COS_REGION=ap-guangzhou
COS_UPLOAD_ENABLED=true

# --- 新增：腾讯云 TTS 配置 (语音合成用，可复用 COS 密钥) ---
# 如果不单独配置，会自动使用上面的 COS_SECRET_ID 和 COS_SECRET_KEY
# TTS_SECRET_ID=your-tts-secret-id  # 可选，留空则复用 COS 密钥
# TTS_SECRET_KEY=your-tts-secret-key  # 可选，留空则复用 COS 密钥
TTS_ENABLED=true  # 是否启用腾讯云TTS（true=启用高质量语音，false=降级gTTS/pyttsx3）

# --- 新增：GitHub OAuth 配置 (登录用) ---
# 登录 GitHub -> Settings -> Developer settings -> OAuth Apps 获取
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# 本地开发填 http://localhost:5173，上线填你的域名
FRONTEND_URL=http://localhost:5173

# 存储配置
STORAGE_MODE=local
LOCAL_STORAGE_PATH=../RG_data

# Python 配置（视频生成功能需要）
PYTHON_EXECUTABLE_PATH=python
VIDEO_GEN_SCRIPT_PATH=scripts/video_gen/generate_daily_video.py

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// 用户表 - 存储用户基本信息
model User {
  id                Int                    @id @default(autoincrement())
  username          String                 @unique @db.VarChar(255)
  passwordHash      String?                @map("password_hash") @db.VarChar(255)
  currentBookTagId  Int?                   @map("current_book_tag_id")
  dailyLearningGoal Int                    @default(10) @map("daily_learning_goal")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamp(0)
  lastLoginAt       DateTime?              @map("last_login_at") @db.Timestamp(0)
  githubId          String?                @unique @map("github_id") @db.VarChar(255)
  dailyCheckIns     DailyCheckIn[]
  achievements      UserAchievement[]
  userBookSettings  UserBookSettings[]
  learningProgress  UserLearningProgress[]
  wordNotebook      UserWordNotebook[]
  currentBookTag    BookTag?               @relation("UserCurrentBook", fields: [currentBookTagId], references: [id])
  videoJobs         VideoGenerationJob[]

  @@index([currentBookTagId], map: "users_current_book_tag_id_fkey")
  @@map("users")
}

/// 视频生成任务表
model VideoGenerationJob {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  jobId        String    @unique @map("job_id") @db.VarChar(255)
  videoType    String    @map("video_type") @db.VarChar(50)
  wordIds      Json      @map("word_ids")
  templateType String    @map("template_type") @db.VarChar(50)
  status       String    @default("pending") @db.VarChar(50)
  progress     Int       @default(0)
  errorMessage String?   @map("error_message") @db.Text
  videoPath    String?   @map("video_path") @db.VarChar(500)
  videoUrl     String?   @map("video_url") @db.VarChar(500)
  duration     Float?
  scenes       Json?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  completedAt  DateTime? @map("completed_at") @db.Timestamp(0)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jobId])
  @@index([status])
  @@map("video_generation_jobs")
}

/// 单词基础表 - 存储单词原文、原型和音标
model Word {
  id            Int                @id @default(autoincrement())
  word          String             @unique @db.VarChar(255)
  lemma         String?            @db.VarChar(255)
  lemmaId       Int?               @map("lemma_id")
  pronunciation Json?
  meanings      Meaning[]
  wordNotebook  UserWordNotebook[]
  bookTags      WordTagRelation[]
  prototype     Word?              @relation("WordLemmas", fields: [lemmaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variants      Word[]             @relation("WordLemmas")

  @@index([word])
  @@index([lemma])
  @@index([lemmaId])
  @@map("words")
}

/// 词义表 - 存储详细释义 (V2 Structure, PartOfSpeech merged)
model Meaning {
  id               Int                      @id @default(autoincrement())
  wordId           Int                      @map("word_id")
  partOfSpeech     String                   @map("part_of_speech") @db.VarChar(50)
  definition       String                   @db.Text
  extra            Json?
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamp(0)
  examples         MeaningExampleRelation[]
  word             Word                     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  learningProgress UserLearningProgress[]

  @@index([wordId])
  @@map("meanings")
}

/// 例句中央池 - 存储所有例句，支持复用
model ExamplePool {
  id           Int                      @id @default(autoincrement())
  sentence     String                   @db.Text
  sourceType   String                   @map("source_type") @db.VarChar(50)
  sourceDetail String?                  @map("source_detail") @db.VarChar(255)
  embedding    Bytes?
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamp(0)
  translation  String?                  @db.Text
  meanings     MeaningExampleRelation[]

  @@index([sourceType])
  @@map("example_pool")
}

/// 词义-例句关联表 - 建立多对多关系
model MeaningExampleRelation {
  meaningId      Int         @map("meaning_id")
  exampleId      Int         @map("example_id")
  highlightWord  String?     @map("highlight_word") @db.VarChar(255)
  orderInMeaning Int?        @map("order_in_meaning")
  isPrimary      Boolean     @default(false) @map("is_primary")
  example        ExamplePool @relation(fields: [exampleId], references: [id], onDelete: Cascade)
  meaning        Meaning     @relation(fields: [meaningId], references: [id], onDelete: Cascade)

  @@id([meaningId, exampleId])
  @@index([meaningId])
  @@index([exampleId])
  @@map("meaning_example_relation")
}

/// 词书标签表 - 存储词书名称
model BookTag {
  id               Int                @id @default(autoincrement())
  tagName          String             @unique @map("tag_name") @db.VarChar(255)
  isUserDefined    Boolean            @default(false) @map("is_user_defined")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamp(0)
  userBookSettings UserBookSettings[]
  users            User[]             @relation("UserCurrentBook")
  words            WordTagRelation[]

  @@index([tagName])
  @@map("book_tags")
}

/// 单词-标签关联表 - 建立多对多关系
model WordTagRelation {
  wordId       Int     @map("word_id")
  bookTagId    Int     @map("book_tag_id")
  masteryFocus String  @map("mastery_focus") @db.VarChar(50)
  bookTag      BookTag @relation(fields: [bookTagId], references: [id], onDelete: Cascade)
  word         Word    @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([wordId, bookTagId])
  @@index([wordId])
  @@index([bookTagId])
  @@map("word_tag_relations")
}

/// 用户-词书配置表 - 存储用户在特定词书下的偏好与稳定乱序 salt
model UserBookSettings {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  bookTagId        Int      @map("book_tag_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  preferences      Json?
  salt             String   @db.VarChar(255)
  shuffleAlgorithm String   @default("stable_hash") @map("shuffle_algorithm") @db.VarChar(50)
  bookTag          BookTag  @relation(fields: [bookTagId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bookTagId])
  @@index([userId])
  @@index([bookTagId])
  @@map("user_book_settings")
}

/// 用户学习进度表 - 记录对每个词义的学习进度（SM-2 算法核心表）
model UserLearningProgress {
  id                 Int       @id @default(autoincrement())
  userId             Int       @map("user_id")
  meaningId          Int       @map("meaning_id")
  masteryLevel       Int       @default(0) @map("mastery_level")
  easinessFactor     Float     @default(2.5) @map("easiness_factor")
  interval           Int       @default(0)
  repetitions        Int       @default(0)
  lastReviewAt       DateTime? @map("last_review_at") @db.Timestamp(0)
  nextReviewAt       DateTime  @map("next_review_at") @db.Timestamp(0)
  reviewCount        Int       @default(0) @map("review_count")
  consecutiveCorrect Int       @default(0) @map("consecutive_correct")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)
  meaning            Meaning   @relation(fields: [meaningId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, meaningId])
  @@index([userId])
  @@index([meaningId])
  @@index([nextReviewAt])
  @@map("user_learning_progress")
}

/// 用户生词本表
model UserWordNotebook {
  id      Int      @id @default(autoincrement())
  userId  Int      @map("user_id")
  wordId  Int      @map("word_id")
  addedAt DateTime @default(now()) @map("added_at") @db.Timestamp(0)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  word    Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId])
  @@index([wordId])
  @@map("user_word_notebook")
}

/// 每日打卡表
model DailyCheckIn {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  checkInDate      DateTime @map("check_in_date") @db.Date
  wordsLearned     Int      @default(0) @map("words_learned")
  wordsReviewed    Int      @default(0) @map("words_reviewed")
  meaningsLearned  Int      @default(0) @map("meanings_learned")
  meaningsReviewed Int      @default(0) @map("meanings_reviewed")
  dailyGoal        Int      @default(10) @map("daily_goal")
  goalCompleted    Boolean  @default(false) @map("goal_completed")
  consecutiveDays  Int      @default(0) @map("consecutive_days")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, checkInDate])
  @@index([userId])
  @@index([checkInDate])
  @@map("daily_check_ins")
}

/// 用户成就表
model UserAchievement {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  achievementKey String   @map("achievement_key") @db.VarChar(50)
  awardedAt      DateTime @default(now()) @map("awarded_at") @db.Timestamp(0)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementKey])
  @@index([userId])
  @@map("user_achievements")
}
